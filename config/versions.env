# AISC — pinned external dependency versions
# Source of truth for Dockerfile ARGs and CI
# Shell-sourceable: KEY=VALUE lines with comments

# Project
AISC_VERSION=2.0.0-dev

# Node.js base image (with digest for reproducible builds)
NODE_IMAGE=node:20-slim
NODE_IMAGE_DIGEST=  # TODO: pin to specific sha256 digest for reproducible builds

# Claude Code (npm package)
CLAUDE_CODE_VERSION=latest  # TODO: pin to specific version

# Mihomo (Clash Meta) — TUN transparent proxy core
MIHOMO_VERSION=v1.19.27

# Geodata (MetaCubeX/meta-rules-dat release tag)
# All three files (geoip.metadb, geosite.dat, country.mmdb) share the same release
GEODATA_VERSION=latest  # TODO: pin to dated release tag for reproducible builds

# cc-switch-cli — cross-platform AI CLI management tool (Rust binary)
CC_SWITCH_VERSION=v5.9.0

# Build flags
USE_CN_MIRROR=1
GH_PROXY=
