#!/bin/bash
set -e

# ==========================================
# API Key 持久化存储文件
# ==========================================
KEY_STORE="/app/.claude_keys"

# 初始化密钥文件（不存在则创建并加固权限）
if [ ! -f "$KEY_STORE" ]; then
    touch "$KEY_STORE"
    chmod 600 "$KEY_STORE"
fi

# ==========================================
# 主菜单
# ==========================================
echo ""
echo "╔══════════════════════════════════════════╗"
echo "║      🔄 Claude 模型后端切换器           ║"
echo "╠══════════════════════════════════════════╣"
echo "║  1) Anthropic 官方                      ║"
echo "║     模型: claude-opus-4-8              ║"
echo "║                                          ║"
echo "║  2) DeepSeek 官方                       ║"
echo "║     模型: deepseek-v4-pro[1m]           ║"
echo "║     URL:  api.deepseek.com              ║"
echo "║                                          ║"
echo "║  3) 硅基流动 · 国产模型                 ║"
echo "║     默认: DeepSeek-V4-Pro               ║"
echo "║                                          ║"
echo "║  4) OpenRouter · 全球路由               ║"
echo "║     默认: Claude Opus 4.8               ║"
echo "║                                          ║"
echo "║  5) 智谱 Z.AI · GLM 系列               ║"
echo "║     默认: GLM-4.6                       ║"
echo "╚══════════════════════════════════════════╝"
echo ""
read -p "👉 请输入选项编号 [1-5]: " CHOICE

# ==========================================
# 根据选择确定配置
# AUTH_METHOD:
#   "api_key"    → export ANTHROPIC_API_KEY（Anthropic 官方）
#   "auth_token" → export ANTHROPIC_AUTH_TOKEN + 清空 ANTHROPIC_API_KEY（第三方，跳过 key 验证）
# ==========================================
case "$CHOICE" in
    1)
        PROVIDER="Anthropic 官方"
        KEY_NAME="ANTHROPIC_OFFICIAL_KEY"
        AUTH_METHOD="api_key"
        unset ANTHROPIC_BASE_URL
        export ANTHROPIC_MODEL="claude-opus-4-8"
        ;;
    2)
        PROVIDER="DeepSeek 官方"
        KEY_NAME="DEEPSEEK_OFFICIAL_KEY"
        AUTH_METHOD="auth_token"
        export ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
        export ANTHROPIC_MODEL="deepseek-v4-pro[1m]"
        ;;
    3)
        echo ""
        echo "╔══════════════════════════════════════════════════════╗"
        echo "║         🏪 硅基流动 — 选择模型                      ║"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  1) DeepSeek-V4-Pro          [⭐ 默认·全能旗舰]      ║"
        echo "║  2) GLM-5.2                  [Code Arena 开源第二]    ║"
        echo "║  3) Nex-N2-Pro               [Agentic Coding 专精]    ║"
        echo "║  4) MiniMax M3               [SWE-Bench Pro 榜首]     ║"
        echo "║  5) Qwen3.6-35B              [极致性价比]             ║"
        echo "╚══════════════════════════════════════════════════════╝"
        echo ""
        read -p "👉 选择模型 [1-5，回车默认 1]: " SUB_CHOICE
        SUB_CHOICE="${SUB_CHOICE:-1}"

        PROVIDER="硅基流动"
        KEY_NAME="SILICONFLOW_KEY"
        AUTH_METHOD="auth_token"
        export ANTHROPIC_BASE_URL="https://api.siliconflow.cn/v1/anthropic"

        case "$SUB_CHOICE" in
            1) SF_MODEL="DeepSeek-V4-Pro"
               export ANTHROPIC_MODEL="Pro/deepseek-ai/DeepSeek-V4-Pro" ;;
            2) SF_MODEL="GLM-5.2"
               export ANTHROPIC_MODEL="Pro/zai-org/GLM-5.2" ;;
            3) SF_MODEL="Nex-N2-Pro"
               export ANTHROPIC_MODEL="Pro/nex/Nex-N2-Pro" ;;
            4) SF_MODEL="MiniMax M3"
               export ANTHROPIC_MODEL="Pro/MiniMaxAI/MiniMax-M3" ;;
            5) SF_MODEL="Qwen3.6-35B"
               export ANTHROPIC_MODEL="Qwen/Qwen3.6-35B-A3B" ;;
            *) echo "❌ 无效选项。"; exit 1 ;;
        esac
        PROVIDER="$PROVIDER ($SF_MODEL)"
        ;;
    4)
        echo ""
        echo "╔══════════════════════════════════════════════════════╗"
        echo "║       🌐 OpenRouter — 选择模型                       ║"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  1) Claude Opus 4.8           [⭐ 默认·Anthropic最强] ║"
        echo "║  2) Claude Sonnet 4.6         [速度与智能平衡]       ║"
        echo "║  3) DeepSeek V3.2             [DeepSeek 最新]         ║"
        echo "║  4) GLM-5.2                   [GLM 旗舰]              ║"
        echo "║  5) Qwen3 Coder Plus          [Qwen 编码专用]         ║"
        echo "║  6) Kimi K2.7 Code            [Kimi 编码]             ║"
        echo "╚══════════════════════════════════════════════════════╝"
        echo ""
        read -p "👉 选择模型 [1-6，回车默认 1]: " SUB_CHOICE
        SUB_CHOICE="${SUB_CHOICE:-1}"

        PROVIDER="OpenRouter"
        KEY_NAME="OPENROUTER_KEY"
        AUTH_METHOD="auth_token"
        export ANTHROPIC_BASE_URL="https://openrouter.ai/api"

        case "$SUB_CHOICE" in
            1) OR_MODEL="Claude Opus 4.8"
               export ANTHROPIC_MODEL="anthropic/claude-opus-4-8" ;;
            2) OR_MODEL="Claude Sonnet 4.6"
               export ANTHROPIC_MODEL="anthropic/claude-sonnet-4-6" ;;
            3) OR_MODEL="DeepSeek V3.2"
               export ANTHROPIC_MODEL="deepseek/deepseek-chat-v3.2" ;;
            4) OR_MODEL="GLM-5.2"
               export ANTHROPIC_MODEL="z-ai/glm-5.2" ;;
            5) OR_MODEL="Qwen3 Coder Plus"
               export ANTHROPIC_MODEL="qwen/qwen3-coder-plus" ;;
            6) OR_MODEL="Kimi K2.7 Code"
               export ANTHROPIC_MODEL="moonshotai/kimi-k2.7-code" ;;
            *) echo "❌ 无效选项。"; exit 1 ;;
        esac
        PROVIDER="$PROVIDER ($OR_MODEL)"
        ;;
    5)
        echo ""
        echo "╔══════════════════════════════════════════════════════╗"
        echo "║        🧠 智谱 Z.AI — 选择模型                      ║"
        echo "╠══════════════════════════════════════════════════════╣"
        echo "║  1) GLM-4.6                   [⭐ 默认·旗舰]          ║"
        echo "║  2) GLM-4.5                   [平衡·通用]            ║"
        echo "║  3) GLM-4.5-Air               [轻量·快速]            ║"
        echo "╚══════════════════════════════════════════════════════╝"
        echo ""
        read -p "👉 选择模型 [1-3，回车默认 1]: " SUB_CHOICE
        SUB_CHOICE="${SUB_CHOICE:-1}"

        PROVIDER="智谱 Z.AI"
        KEY_NAME="ZHIPU_KEY"
        AUTH_METHOD="auth_token"
        export ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"

        case "$SUB_CHOICE" in
            1) ZP_MODEL="GLM-4.6"
               export ANTHROPIC_MODEL="glm-4.6" ;;
            2) ZP_MODEL="GLM-4.5"
               export ANTHROPIC_MODEL="glm-4.5" ;;
            3) ZP_MODEL="GLM-4.5-Air"
               export ANTHROPIC_MODEL="glm-4.5-air" ;;
            *) echo "❌ 无效选项。"; exit 1 ;;
        esac
        PROVIDER="$PROVIDER ($ZP_MODEL)"
        ;;
    *)
        echo "❌ 无效选项，请输入 1-5 之间的数字。"
        exit 1
        ;;
esac

echo ""
echo "✅ 已选择: $PROVIDER"

# ==========================================
# 核心鉴权逻辑：读取或收集 API Key
# ==========================================
EXISTING_KEY=$(grep "^${KEY_NAME}=" "$KEY_STORE" 2>/dev/null | head -1 | cut -d'=' -f2-)

if [ -n "$EXISTING_KEY" ]; then
    if [ "$AUTH_METHOD" = "auth_token" ]; then
        # 第三方平台：用 AUTH_TOKEN，清空 API_KEY（跳过 Anthropic key 验证）
        export ANTHROPIC_AUTH_TOKEN="$EXISTING_KEY"
        export ANTHROPIC_API_KEY=""
    else
        # Anthropic 官方：直接用 API_KEY
        export ANTHROPIC_API_KEY="$EXISTING_KEY"
    fi
    echo "🔑 已从本地密钥库加载 API Key。"
else
    echo "🔐 首次使用 [$PROVIDER]，需要输入 API Key。"
    read -s -p "📝 请粘贴你的 API Key（输入不会显示在屏幕上）: " USER_KEY
    echo ""

    if [ -z "$USER_KEY" ]; then
        echo "❌ API Key 不能为空，已取消。"
        exit 1
    fi

    # 持久化保存
    echo "${KEY_NAME}=${USER_KEY}" >> "$KEY_STORE"

    if [ "$AUTH_METHOD" = "auth_token" ]; then
        export ANTHROPIC_AUTH_TOKEN="$USER_KEY"
        export ANTHROPIC_API_KEY=""
    else
        export ANTHROPIC_API_KEY="$USER_KEY"
    fi
    echo "✅ API Key 已安全保存至 $KEY_STORE"
fi

# ==========================================
# 移交控制权给 Claude
# ==========================================
echo "🚀 正在启动 Claude..."
echo ""
exec claude "$@"
