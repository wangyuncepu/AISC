#!/usr/bin/env bash
# cs / claude-switch — switch Claude Code between cc / deepseek / ark / 1y / duo-cc
# API Keys stored in ~/.claude/api-keys (chmod 600), never in this file.
# Modifies ~/.claude/settings.json env block only; everything else untouched.

# env 块写进 Claude CLI 原生 settings.json（CLAUDE_CONFIG_DIR/settings.json）。
# 这样 Claude Code 原生读取并实时生效（与非 docker 行为一致，!cs ds 立即更新）。
CFG_DIR="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
SETTINGS_RAW="${CFG_DIR}/settings.json"

# api-keys 密钥仍独立存于 .cc-config（与 .claude 分离）解析顺序：
#   1) CC_CONFIG_DIR（entrypoint 导出，恒为 /app/.cc-config）
#   2) Docker 项目卷 /app/.cc-config
#   3) 当前目录 ./.cc-config
#   4) 全局 ~/.cc-config
if [ -n "${CC_CONFIG_DIR:-}" ]; then
  KEY_DIR="$CC_CONFIG_DIR"
elif [ -d /app ]; then
  KEY_DIR="/app/.cc-config"
elif [ -f "./.cc-config/api-keys" ]; then
  KEY_DIR="$(pwd)/.cc-config"
else
  KEY_DIR="${HOME}/.cc-config"
fi
KEY_STORE="${KEY_DIR}/api-keys"

# Windows Git Bash needs cygpath for Node.js; Linux containers use the POSIX path directly.
if command -v cygpath >/dev/null 2>&1; then
  SETTINGS=$(cygpath -w "$SETTINGS_RAW" | sed 's/\\/\//g')
else
  SETTINGS="$SETTINGS_RAW"
fi

# Ensure config dirs exist (.claude for settings, .cc-config for keys)
mkdir -p "$(dirname "$SETTINGS_RAW")" "$KEY_DIR"

# Init settings.json if missing
if [ ! -f "$SETTINGS_RAW" ]; then
  printf '{\n  "env": {}\n}\n' > "$SETTINGS_RAW"
fi

# Init key store if missing
if [ ! -f "$KEY_STORE" ]; then
  touch "$KEY_STORE"
  chmod 600 "$KEY_STORE"
fi

# ====== Endpoint URLs (non-secret) ======
DEEPSEEK_BASE="${DEEPSEEK_BASE:-https://api.deepseek.com/anthropic}"
GLM_BASE="${GLM_BASE:-https://ark.cn-beijing.volces.com/api/coding}"
ONEY_BASE="${ONEY_BASE:-https://1yuanapi.com}"
DUOCC_BASE="${DUOCC_BASE:-https://api.duou.cc}"
# =========================================

die() { echo "ERROR: $*" >&2; exit 1; }

# ==========================================
# get_key — read key from store, or prompt user
# ==========================================
get_key() {
  local name="$1"
  local label="$2"
  local key

  key=$(grep "^${name}=" "$KEY_STORE" 2>/dev/null | tail -1 | cut -d'=' -f2- | tr -d '\r')

  if [ -z "$key" ]; then
    echo "" >&2
    echo "🔐 后端 [$label] 需要 API Key" >&2
    read -s -p "📝 请粘贴 Key（输入不会显示）: " key
    echo "" >&2
    if [ -z "$key" ]; then
      echo "❌ Key 不能为空，已取消。" >&2
      return 1
    fi
    echo "${name}=${key}" >> "$KEY_STORE"
    chmod 600 "$KEY_STORE"
    echo "✅ Key 已保存至 $KEY_STORE" >&2
  fi

  printf '%s' "$key"
}

# ==========================================
# write_settings — write env block via Node
# All values passed through env vars to avoid shell->JS escaping issues.
# ==========================================
write_settings() {
  node -e "
    const fs = require('fs');
    let cfg = JSON.parse(fs.readFileSync('${SETTINGS}','utf8'));
    cfg.env = {
      ANTHROPIC_BASE_URL: process.env.CS_BASE_URL || '',
      ANTHROPIC_AUTH_TOKEN: process.env.CS_AUTH_TOKEN || '',
      ANTHROPIC_API_KEY: process.env.CS_API_KEY || '',
      ANTHROPIC_MODEL: process.env.CS_MODEL || '',
      ANTHROPIC_DEFAULT_OPUS_MODEL: process.env.CS_DEFAULT_OPUS || '',
      ANTHROPIC_DEFAULT_SONNET_MODEL: process.env.CS_DEFAULT_SONNET || '',
      ANTHROPIC_DEFAULT_HAIKU_MODEL: process.env.CS_DEFAULT_HAIKU || '',
      CLAUDE_CODE_SUBAGENT_MODEL: process.env.CS_SUBAGENT || '',
      CLAUDE_CODE_EFFORT_LEVEL: process.env.CS_EFFORT || '',
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: process.env.CS_COMPACT || ''
    };
    delete cfg.model;  // 清除 Claude Code 的 model 固定，让 env.ANTHROPIC_MODEL 接管
    fs.writeFileSync('${SETTINGS}', JSON.stringify(cfg, null, 2) + '\n');
  " || die "failed to write settings"
}

switch() {
  local mode="$1"
  local key

  case "$mode" in
    cc)
      # 官方默认：允许留空，所有配置清为 ""（走 Anthropic 默认端点 / 自带登录）
      export CS_BASE_URL="" CS_AUTH_TOKEN="" CS_API_KEY=""
      export CS_MODEL="" CS_DEFAULT_OPUS="" CS_DEFAULT_SONNET="" CS_DEFAULT_HAIKU=""
      export CS_SUBAGENT="" CS_EFFORT="" CS_COMPACT=""
      echo "Switched to: Claude (default Anthropic, 全部配置已清空)"
      ;;
    deepseek)
      key=$(get_key "DEEPSEEK_KEY" "DeepSeek") || return 1
      export CS_BASE_URL="$DEEPSEEK_BASE" CS_AUTH_TOKEN="$key" CS_API_KEY=""
      export CS_MODEL="deepseek-v4-pro[1m]"
      export CS_DEFAULT_OPUS="deepseek-v4-pro[1m]" CS_DEFAULT_SONNET="deepseek-v4-pro[1m]"
      export CS_DEFAULT_HAIKU="deepseek-v4-flash" CS_SUBAGENT="deepseek-v4-flash"
      export CS_EFFORT="max" CS_COMPACT=""
      echo "Switched to: DeepSeek"
      ;;
    ark)
      key=$(get_key "GLM_KEY" "Ark") || return 1
      export CS_BASE_URL="$GLM_BASE" CS_AUTH_TOKEN="$key" CS_API_KEY=""
      export CS_MODEL="glm-5.2[1m]"
      export CS_DEFAULT_OPUS="glm-5.2[1m]" CS_DEFAULT_SONNET="glm-5.2[1m]"
      export CS_DEFAULT_HAIKU="glm-4.7" CS_SUBAGENT="glm-4.7"
      export CS_EFFORT="" CS_COMPACT="1000000"
      echo "Switched to: Ark"
      ;;
    1y)
      key=$(get_key "ONEY_KEY" "1yuanapi") || return 1
      export CS_BASE_URL="$ONEY_BASE" CS_AUTH_TOKEN="$key" CS_API_KEY=""
      export CS_MODEL="claude-sonnet-4-8[1m]"
      export CS_DEFAULT_OPUS="claude-opus-4-8[1m]" CS_DEFAULT_SONNET="claude-sonnet-4-6[1m]"
      export CS_DEFAULT_HAIKU="claude-haiku-4-5-20251001[1m]" CS_SUBAGENT="claude-haiku-4-5-20251001[1m]"
      export CS_EFFORT="" CS_COMPACT=""
      echo "Switched to: 1y (1yuanapi.com)"
      ;;
    duo-cc)
      key=$(get_key "DUOCC_KEY" "duo-cc") || return 1
      export CS_BASE_URL="$DUOCC_BASE" CS_AUTH_TOKEN="$key" CS_API_KEY=""
      export CS_MODEL="claude-sonnet-4-8[1m]"
      export CS_DEFAULT_OPUS="claude-opus-4-8[1m]" CS_DEFAULT_SONNET="claude-sonnet-4-6[1m]"
      export CS_DEFAULT_HAIKU="claude-haiku-4-5-20251001[1m]" CS_SUBAGENT="claude-haiku-4-5-20251001[1m]"
      export CS_EFFORT="" CS_COMPACT=""
      echo "Switched to: duo-cc (api.duou.cc)"
      ;;
    *)
      die "unknown mode: ${mode}"
      ;;
  esac

  write_settings

  if [ "${SC_RESTART:-}" = "1" ]; then
    echo "Restarting Claude with new settings..."
    exec claude
  fi
}

show_current() {
  echo ""
  echo "Current backend:"
  node -e "
    const cfg = require('${SETTINGS}');
    const env = cfg.env || {};
    const base = env.ANTHROPIC_BASE_URL || '';
    if (!base)                          { console.log('  cc (Anthropic default)'); }
    else if (base.includes('deepseek')) { console.log('  deepseek'); }
    else if (base.includes('volces'))   { console.log('  ark'); }
    else if (base.includes('1yuanapi')) { console.log('  1y'); }
    else if (base.includes('duou.cc'))  { console.log('  duo-cc'); }
    else                                { console.log('  custom → ' + base); }
  " 2>/dev/null || echo "  unknown"

  echo ""
  echo "Saved keys:"
  for entry in "ANTHROPIC_OFFICIAL_KEY:Anthropic" "DEEPSEEK_KEY:DeepSeek" "GLM_KEY:Ark" "ONEY_KEY:1yuanapi" "DUOCC_KEY:duo-cc"; do
    name="${entry%%:*}"
    label="${entry##*:}"
    if grep -q "^${name}=." "$KEY_STORE" 2>/dev/null; then
      echo "  $label ✓"
    else
      echo "  $label ✗"
    fi
  done
  echo ""
}

# ==========================================
# do_upgrade — 把镜像出厂 .claude 合并进当前项目 .claude
#   叠加覆盖出厂部分（保留项目自加项），合并 settings（留用户 env），
#   再对“项目独有”项逐项询问删除（默认保留），最后同步版本戳。
# ==========================================
do_upgrade() {
  local SRC="/root/.claude"
  local DST="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  [ -d "$SRC" ] || die "未找到镜像出厂 .claude: $SRC"
  [ "$DST" = "$SRC" ] && die "临时模式（$SRC 即出厂本体），无需升级"

  echo "⬆️  升级项目 .claude：$DST  ←  出厂 $SRC"

  # 1) 叠加覆盖出厂部分（cp -rf 不 rm，保留项目自加项）
  for d in skills plugins commands; do
    [ -d "$SRC/$d" ] || continue
    mkdir -p "$DST/$d"
    cp -rf "$SRC/$d/." "$DST/$d/"
  done
  [ -f "$SRC/CLAUDE.md" ]          && cp -f "$SRC/CLAUDE.md" "$DST/CLAUDE.md"
  [ -f "$SRC/settings.local.json" ] && cp -f "$SRC/settings.local.json" "$DST/settings.local.json"

  # 2) 合并 settings.json：出厂字段更新 + 保留用户 env（cs 后端选择）
  if [ -f "$SRC/settings.json" ]; then
    SRC="$SRC" DST="$DST" node -e '
      const fs=require("fs");
      const fac=JSON.parse(fs.readFileSync(process.env.SRC+"/settings.json","utf8"));
      let usr={}; try{usr=JSON.parse(fs.readFileSync(process.env.DST+"/settings.json","utf8"))}catch(e){}
      if (usr.env) fac.env = usr.env;
      fs.writeFileSync(process.env.DST+"/settings.json", JSON.stringify(fac,null,2)+"\n");
    ' || die "settings.json 合并失败"
  fi
  echo "✅ 出厂部分已更新（skills/plugins/commands/CLAUDE.md/settings）。"

  # 3) “项目独有”项（出厂中没有，可能自加 or 出厂已删）→ 表格多选删除，默认全部保留
  local -a OPATH=() OLABEL=()
  local d item name
  for d in skills commands; do
    [ -d "$DST/$d" ] || continue
    for item in "$DST/$d"/*; do
      [ -e "$item" ] || continue
      name="$(basename "$item")"
      if [ ! -e "$SRC/$d/$name" ]; then
        OPATH+=("$item"); OLABEL+=("$d/$name")
      fi
    done
  done

  if [ "${#OPATH[@]}" -gt 0 ]; then
    echo ""
    echo "📋 项目独有项（出厂中没有）："
    local i
    for i in "${!OLABEL[@]}"; do printf "   [%d] %s\n" "$((i+1))" "${OLABEL[$i]}"; done
    echo ""
    local sel=""
    if [ -t 0 ]; then
      printf "输入要删除的编号 (空格分隔; a=全部; 回车=全部保留): "
      read -r sel || sel=""
    fi
    if [ -z "$sel" ]; then
      echo "   ✅ 全部保留。"
    elif [ "$sel" = "a" ] || [ "$sel" = "all" ]; then
      for i in "${!OPATH[@]}"; do rm -rf "${OPATH[$i]}"; echo "   🗑️  删除 ${OLABEL[$i]}"; done
    else
      local n idx
      for n in $sel; do
        case "$n" in
          ''|*[!0-9]*) echo "   ⚠ 跳过无效编号: $n" ;;
          *) idx=$((n-1))
             if [ -n "${OPATH[$idx]:-}" ]; then rm -rf "${OPATH[$idx]}"; echo "   🗑️  删除 ${OLABEL[$idx]}"
             else echo "   ⚠ 编号越界: $n"; fi ;;
        esac
      done
    fi
  fi

  # 4) 同步版本戳
  [ -f "$SRC/.factory-version" ] && cp -f "$SRC/.factory-version" "$DST/.factory-version"

  # 5) 权限交还宿主机用户（项目挂载卷）
  if [ -d /app ]; then
    local U G; U=$(stat -c "%u" /app 2>/dev/null || echo 0); G=$(stat -c "%g" /app 2>/dev/null || echo 0)
    [ "$U" != "0" ] && chown -R "$U:$G" "$DST" 2>/dev/null || true
  fi
  echo "🎉 升级完成。"
}

case "${1:-}" in
  cc|default|anthropic)  switch cc ;;
  deepseek|ds)           switch deepseek ;;
  ark)                   switch ark ;;
  1y|oney)               switch 1y ;;
  duo-cc|duo|duou)       switch duo-cc ;;
  upgrade|up)            do_upgrade ;;
  show|current|"")       show_current ;;
  -h|--help)
    echo "Usage: cs {cc|deepseek|ark|1y|duo-cc|upgrade|show}"
    echo ""
    echo "  cc        Claude default (Anthropic)"
    echo "  deepseek  DeepSeek V4"
    echo "  ark       Ark"
    echo "  1y        1yuanapi.com (Claude models proxied)"
    echo "  duo-cc    api.duou.cc (Claude models proxied)"
    echo "  upgrade   合并镜像出厂 .claude 到当前项目（保留后端配置/历史）"
    echo "  show      Show current backend & saved keys"
    echo ""
    echo "Keys are stored in .cc-config/api-keys and never committed to git."
    ;;
  *)
    die "unknown: $1  —  use cc, deepseek, ark, 1y, duo-cc, upgrade, or show"
    ;;
esac
