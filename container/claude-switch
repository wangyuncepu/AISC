#!/usr/bin/env bash
# cs / claude-switch — switch Claude Code between providers
# API Keys stored in ~/.aisc/secrets/api-keys (chmod 600), never in this file.
# Modifies ~/.claude/settings.json env block only; everything else untouched.
# Provider data comes from PROVIDERS_JSON; AISC entrypoint points it at the
# project-local .aisc/.cc-switch/providers.json shared catalog.

# env 块写进 Claude CLI 原生 settings.json（CLAUDE_CONFIG_DIR/settings.json）。
# 这样 Claude Code 原生读取并实时生效（与非 docker 行为一致，!cs ds 立即更新）。
CFG_DIR="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
SETTINGS_RAW="${CFG_DIR}/settings.json"

# api-keys 密钥存于 .aisc/secrets/api-keys
# 解析顺序：
#   1) AISC_DIR（entrypoint 导出，恒为 /root/app/.aisc）
#   2) Docker 项目卷 /root/app/.aisc
#   3) 全局 ~/.aisc
if [ -n "${AISC_DIR:-}" ]; then
  AISC_SECRETS_DIR="$AISC_DIR/secrets"
elif [ -d /root/app/.aisc ]; then
  AISC_SECRETS_DIR="/root/app/.aisc/secrets"
else
  AISC_SECRETS_DIR="${HOME}/.aisc/secrets"
fi
AISC_KEY_STORE="${AISC_SECRETS_DIR}/api-keys"

# Windows Git Bash needs cygpath for Node.js; Linux containers use the POSIX path directly.
if command -v cygpath >/dev/null 2>&1; then
  SETTINGS=$(cygpath -w "$SETTINGS_RAW" | sed 's/\\/\//g')
else
  SETTINGS="$SETTINGS_RAW"
fi

# Ensure config dirs exist (.claude for settings, .aisc/secrets for keys)
mkdir -p "$(dirname "$SETTINGS_RAW")" "$AISC_SECRETS_DIR"

# Init settings.json if missing
if [ ! -f "$SETTINGS_RAW" ]; then
  printf '{\n  "env": {}\n}\n' > "$SETTINGS_RAW"
fi

# Init key store if missing
if [ ! -f "$AISC_KEY_STORE" ]; then
  touch "$AISC_KEY_STORE"
  chmod 600 "$AISC_KEY_STORE"
fi

# Resolve providers.json — the entrypoint exports the canonical shared catalog.
# Priority: explicit PROVIDERS_JSON > project cc-switch > ~/.aisc > Docker fallback.
if [ -n "${PROVIDERS_JSON:-}" ] && [ -f "$PROVIDERS_JSON" ]; then
  PROVIDERS_JSON="$PROVIDERS_JSON"
elif [ -n "${AISC_DIR:-}" ] && [ -f "$AISC_DIR/.cc-switch/providers.json" ]; then
  PROVIDERS_JSON="$AISC_DIR/.cc-switch/providers.json"
elif [ -f "${HOME}/.aisc/providers.json" ]; then
  PROVIDERS_JSON="${HOME}/.aisc/providers.json"
else
  PROVIDERS_JSON="${PROVIDERS_JSON:-/root/providers.json}"
fi
export PROVIDERS_JSON
mkdir -p "$(dirname "$PROVIDERS_JSON")"

die() { echo "ERROR: $*" >&2; exit 1; }

# _ensure_dir DIR — create a directory as the container's root user
_ensure_dir() {
  local d="$1"
  [ -n "$d" ] || return 1
  [ -d "$d" ] && return 0
  if mkdir -p -- "$d" 2>/dev/null; then
    return 0
  fi
  echo "ERROR: cannot create directory '$d'" >&2
  return 1
}

# ==========================================
# _node_read_providers — output shell variable assignments for a provider
#   Usage: eval "$(_node_resolve_provider <mode>)"
#   Sets: _PR_ID, _PR_NAME, _PR_AUTH_KEY_NAME, _PR_AUTH_PROMPT, _PR_KEY_DISPLAY,
#         _PR_AUTH_TYPE, _PR_CLEAR_ALL, _PR_BASE_URL, _PR_MODEL, _PR_OPUS, _PR_SONNET,
#         _PR_HAIKU, _PR_SUBAGENT, _PR_EFFORT, _PR_COMPACT, _PR_SWITCH_MSG,
#         _PR_URL_FRAGMENT, _PR_HELP_DESC
#   If not found, sets _PR_VALID=0
# ==========================================
_node_resolve_provider() {
  node -e '
    var fs = require("fs");
    var pj=process.env.PROVIDERS_JSON;if(!pj)throw Error("PROVIDERS_JSON env var not set");var cfg=JSON.parse(fs.readFileSync(pj,"utf8"));
    var input = process.argv[1] || "";
    var providers = cfg.providers || {};
    var id = "";
    for (var k in providers) {
      if (k === input) { id = k; break; }
      var aliases = providers[k].aliases || [];
      if (aliases.indexOf(input) !== -1) { id = k; break; }
    }
    if (!id || !providers[id]) {
      console.log("_PR_VALID=0");
      process.exit(0);
    }
    var p = providers[id];
    var q = JSON.stringify;
    console.log("_PR_VALID=1");
    console.log("_PR_ID=" + q(p.id || id));
    console.log("_PR_NAME=" + q(p.name || ""));
    console.log("_PR_AUTH_KEY_NAME=" + q(p.auth_key_name || ""));
    console.log("_PR_AUTH_PROMPT=" + q(p.auth_prompt || ""));
    console.log("_PR_KEY_DISPLAY=" + q(p.key_display || p.auth_prompt || ""));
    console.log("_PR_AUTH_TYPE=" + q(p.auth_type || ""));
    console.log("_PR_CLEAR_ALL=" + (p.clear_all ? "1" : "0"));
    console.log("_PR_BASE_URL=" + q(p.base_url || ""));
    console.log("_PR_MODEL=" + q(p.model || ""));
    console.log("_PR_OPUS=" + q(p.default_opus || ""));
    console.log("_PR_SONNET=" + q(p.default_sonnet || ""));
    console.log("_PR_HAIKU=" + q(p.default_haiku || ""));
    console.log("_PR_SUBAGENT=" + q(p.subagent || ""));
    console.log("_PR_EFFORT=" + q(p.effort || ""));
    console.log("_PR_COMPACT=" + q(p.compact || ""));
    console.log("_PR_SWITCH_MSG=" + q(p.switch_msg || p.name || ""));
    console.log("_PR_URL_FRAGMENT=" + q(p.url_fragment || ""));
    console.log("_PR_HELP_DESC=" + q(p.help_desc || p.name || ""));
  ' "$1"
}

# ==========================================
# _node_list_providers — output shell assignments for all provider keys/display names
#   Sets: _PL_COUNT=N, _PL_ID_0=.., _PL_KEYNAME_0=.., _PL_KEYDISP_0=.., ...
# ==========================================
_node_list_providers() {
  node -e '
    var fs = require("fs");
    var pj=process.env.PROVIDERS_JSON;if(!pj)throw Error("PROVIDERS_JSON env var not set");var cfg=JSON.parse(fs.readFileSync(pj,"utf8"));
    var providers = cfg.providers || {};
    var keys = Object.keys(providers);
    var q = JSON.stringify;
    console.log("_PL_COUNT=" + keys.length);
    for (var i = 0; i < keys.length; i++) {
      var p = providers[keys[i]];
      console.log("_PL_ID_" + i + "=" + q(keys[i]));
      console.log("_PL_KEYNAME_" + i + "=" + q(p.auth_key_name || ""));
      console.log("_PL_KEYDISP_" + i + "=" + q(p.key_display || p.auth_prompt || ""));
      console.log("_PL_URLFRAG_" + i + "=" + q(p.url_fragment || ""));
      console.log("_PL_SWITCHMSG_" + i + "=" + q(p.switch_msg || p.name || ""));
      console.log("_PL_HELPDESC_" + i + "=" + q(p.help_desc || p.name || ""));
      var aliases = (p.aliases || []).join("|");
      console.log("_PL_ALIASES_" + i + "=" + q(aliases));
      var allNames = [keys[i]].concat(p.aliases || []);
      console.log("_PL_ALLNAMES_" + i + "=" + q(allNames.join("|")));
    }
  '
}

# ==========================================
# get_key — read key from .aisc/secrets/api-keys, prompt user if missing
# ==========================================
get_key() {
  local name="$1"
  local label="$2"
  local key

  # Read from .aisc/secrets/api-keys
  if [ -f "$AISC_KEY_STORE" ]; then
    key=$(grep "^${name}=" "$AISC_KEY_STORE" 2>/dev/null | tail -1 | cut -d'=' -f2- | tr -d '\r')
  fi

  if [ -z "$key" ]; then
    echo "" >&2
    echo "🔐 后端 [$label] 需要 API Key" >&2
    read -s -p "📝 请粘贴 Key（输入不会显示）: " key
    echo "" >&2
    if [ -z "$key" ]; then
      echo "❌ Key 不能为空，已取消。" >&2
      return 1
    fi

    # Save to .aisc/secrets/api-keys
    if ! _ensure_dir "$AISC_SECRETS_DIR" 2>&1; then
      echo "❌ 无法创建目录 ${AISC_SECRETS_DIR}" >&2
      return 1
    fi

    if ! echo "${name}=${key}" >> "$AISC_KEY_STORE" 2>&1; then
      echo "❌ 无法保存 Key 到 ${AISC_KEY_STORE}" >&2
      return 1
    fi

    chmod 600 "$AISC_KEY_STORE" 2>/dev/null || true
    echo "✅ Key 已保存到 ${AISC_KEY_STORE}" >&2
  fi

  printf '%s' "$key"
}

# ==========================================
# write_settings — write env block via Node
# All values passed through env vars to avoid shell->JS escaping issues.
# ==========================================
write_settings() {
  node -e "
    const fs = require('fs');
    let cfg = JSON.parse(fs.readFileSync('${SETTINGS}','utf8'));
    cfg.env = {
      ANTHROPIC_BASE_URL: process.env.CS_BASE_URL || '',
      ANTHROPIC_AUTH_TOKEN: process.env.CS_AUTH_TOKEN || '',
      ANTHROPIC_API_KEY: process.env.CS_API_KEY || '',
      ANTHROPIC_MODEL: process.env.CS_MODEL || '',
      ANTHROPIC_DEFAULT_OPUS_MODEL: process.env.CS_DEFAULT_OPUS || '',
      ANTHROPIC_DEFAULT_SONNET_MODEL: process.env.CS_DEFAULT_SONNET || '',
      ANTHROPIC_DEFAULT_HAIKU_MODEL: process.env.CS_DEFAULT_HAIKU || '',
      CLAUDE_CODE_SUBAGENT_MODEL: process.env.CS_SUBAGENT || '',
      CLAUDE_CODE_EFFORT_LEVEL: process.env.CS_EFFORT || '',
      CLAUDE_CODE_AUTO_COMPACT_WINDOW: process.env.CS_COMPACT || ''
    };
    delete cfg.model;  // 清除 Claude Code 的 model 固定，让 env.ANTHROPIC_MODEL 接管
    fs.writeFileSync('${SETTINGS}', JSON.stringify(cfg, null, 2) + '\n');
  " || die "failed to write settings"
}

# ==========================================
# switch — data-driven provider switching
# ==========================================
switch() {
  local mode="$1"
  local key=""

  # Resolve provider via providers.json
  eval "$(_node_resolve_provider "$mode")"
  [ "${_PR_VALID:-0}" = "0" ] && die "unknown mode: ${mode}"

  # Get key if provider requires one
  if [ "${_PR_CLEAR_ALL:-0}" != "1" ] && [ -n "${_PR_AUTH_KEY_NAME:-}" ]; then
    key=$(get_key "$_PR_AUTH_KEY_NAME" "$_PR_AUTH_PROMPT") || return 1
  fi

  # Set env vars (identical to original write_settings expectations)
  export CS_BASE_URL="${_PR_BASE_URL:-}"
  if [ "${_PR_AUTH_TYPE:-}" = "token" ]; then
    export CS_AUTH_TOKEN="$key"
    export CS_API_KEY=""
  else
    export CS_AUTH_TOKEN=""
    export CS_API_KEY="$key"
  fi
  export CS_MODEL="${_PR_MODEL:-}"
  export CS_DEFAULT_OPUS="${_PR_OPUS:-}"
  export CS_DEFAULT_SONNET="${_PR_SONNET:-}"
  export CS_DEFAULT_HAIKU="${_PR_HAIKU:-}"
  export CS_SUBAGENT="${_PR_SUBAGENT:-}"
  export CS_EFFORT="${_PR_EFFORT:-}"
  export CS_COMPACT="${_PR_COMPACT:-}"

  write_settings

  # cc-switch v5+ stores providers in SQLite. Import the live Claude config
  # after a cs switch so its TUI/daemon sees the same selected provider.
  # Best-effort: cs remains usable if cc-switch is unavailable or rejects an
  # unsupported live configuration.
  if command -v cc-switch >/dev/null 2>&1; then
    cc-switch --app claude provider import-live >/tmp/cc-switch-import-live.log 2>&1 || true
  fi
  echo "Switched to: ${_PR_SWITCH_MSG}"

  if [ "${SC_RESTART:-}" = "1" ]; then
    echo "Restarting Claude with new settings..."
    exec claude
  fi
}

# ==========================================
# show_current — display current settings + saved keys
# ==========================================
show_current() {
  echo ""
  node -e "
    const fs = require('fs');
    try {
      const cfg = JSON.parse(fs.readFileSync('${SETTINGS}','utf8'));
      const env = cfg.env || {};
      const labels = {
        ANTHROPIC_BASE_URL:       'BASE URL',
        ANTHROPIC_AUTH_TOKEN:     'AUTH TOKEN',
        ANTHROPIC_API_KEY:        'API KEY',
        ANTHROPIC_MODEL:          'MODEL',
        ANTHROPIC_DEFAULT_OPUS_MODEL: 'OPUS',
        ANTHROPIC_DEFAULT_SONNET_MODEL: 'SONNET',
        ANTHROPIC_DEFAULT_HAIKU_MODEL: 'HAIKU',
        CLAUDE_CODE_SUBAGENT_MODEL: 'SUBAGENT',
        CLAUDE_CODE_EFFORT_LEVEL: 'EFFORT',
        CLAUDE_CODE_AUTO_COMPACT_WINDOW: 'COMPACT'
      };
      console.log('=== 当前配置 ===');
      for (const [k, v] of Object.entries(env)) {
        const label = labels[k] || k;
        const val = v || '(empty)';
        const sensitive = (k.includes('TOKEN') || k.includes('KEY')) && v;
        console.log('  ' + label.padEnd(12) + ' = ' + (sensitive ? v.slice(0,12) + '...' + v.slice(-4) : val));
      }
      const base = env.ANTHROPIC_BASE_URL || '';
      // Build backend fragments from providers.json
      const pj=process.env.PROVIDERS_JSON;if(!pj)throw Error('PROVIDERS_JSON env var not set');const provCfg=JSON.parse(fs.readFileSync(pj,'utf8'));
      const providers = provCfg.providers || {};
      let backend = '';
      for (const [id, p] of Object.entries(providers)) {
        const frag = p.url_fragment || '';
        if (frag && base.includes(frag)) { backend = id; break; }
      }
      if (!backend && !base) {
        backend = 'cc';
      }
      if (backend) {
        const p = providers[backend];
        const showLabel = p ? (p.switch_msg || p.name || backend) : backend;
        console.log('\\n  后端: ' + backend + (p && p.name ? ' (' + p.name + ')' : ''));
      } else if (base) {
        console.log('\\n  后端: custom → ' + base);
      } else {
        console.log('\\n  后端: cc (Anthropic)');
      }
    } catch (e) {
      console.error('❌ 无法读取配置文件');
      console.error('   路径: ${SETTINGS}');
      console.error('   错误: ' + e.message);
      console.error('   提示: 检查文件是否存在，权限是否正确，或环境变量 CLAUDE_CONFIG_DIR 是否设置');
      process.exit(1);
    }
  "

  echo ""
  echo "Saved keys:"
  # Read key listing from providers.json (dynamic, no hardcoded entries)
  eval "$(_node_list_providers)"
  local i
  for i in $(seq 0 $((_PL_COUNT - 1))); do
    eval 'local keyname="${_PL_KEYNAME_'${i}'}"'
    eval 'local keydisp="${_PL_KEYDISP_'${i}'}"'
    if [ -n "$keyname" ] && grep -q "^${keyname}=." "$AISC_KEY_STORE" 2>/dev/null; then
      echo "  $keydisp ✓"
    else
      echo "  $keydisp ✗"
    fi
  done
  echo ""
}

# ==========================================
# do_upgrade — 把镜像出厂 .claude 合并进当前项目 .claude
#   叠加覆盖出厂部分（保留项目自加项），合并 settings（留用户 env），
#   再对“项目独有”项逐项询问删除（默认保留），最后同步版本戳。
# ==========================================
do_upgrade() {
  local SRC="/root/.claude"
  local DST="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  [ -d "$SRC" ] || die "未找到镜像出厂 .claude: $SRC"
  [ "$DST" = "$SRC" ] && die "临时模式（$SRC 即出厂本体），无需升级"

  echo "⬆️  升级项目 .claude：$DST  ←  出厂 $SRC"

  # 1) 叠加覆盖出厂部分（cp -rf 不 rm，保留项目自加项）
  for d in skills plugins commands; do
    [ -d "$SRC/$d" ] || continue
    mkdir -p "$DST/$d"
    cp -rfL "$SRC/$d/." "$DST/$d/"   # -L 解引用符号链接，兼容 Windows 绑定挂载
  done
  [ -f "$SRC/CLAUDE.md" ]          && cp -f "$SRC/CLAUDE.md" "$DST/CLAUDE.md"
  [ -f "$SRC/settings.local.json" ] && cp -f "$SRC/settings.local.json" "$DST/settings.local.json"

  # 修正插件注册表路径 /root/.claude → 项目目录（避免 orphan 误删）
  for j in installed_plugins.json known_marketplaces.json; do
    [ -f "$DST/plugins/$j" ] && sed -i "s#${SRC}#${DST}#g" "$DST/plugins/$j" 2>/dev/null || true
  done

  # 2) 合并 settings.json：出厂字段更新 + 保留用户 env（cs 后端选择）
  if [ -f "$SRC/settings.json" ]; then
    SRC="$SRC" DST="$DST" node -e '
      const fs=require("fs");
      const fac=JSON.parse(fs.readFileSync(process.env.SRC+"/settings.json","utf8"));
      let usr={}; try{usr=JSON.parse(fs.readFileSync(process.env.DST+"/settings.json","utf8"))}catch(e){}
      if (usr.env) fac.env = usr.env;
      fs.writeFileSync(process.env.DST+"/settings.json", JSON.stringify(fac,null,2)+"\n");
    ' || die "settings.json 合并失败"
  fi
  echo "✅ 出厂部分已更新（skills/plugins/commands/CLAUDE.md/settings）。"

  # 3) “项目独有”项（出厂中没有，可能自加 or 出厂已删）→ 表格多选删除，默认全部保留
  local -a OPATH=() OLABEL=()
  local d item name
  for d in skills commands; do
    [ -d "$DST/$d" ] || continue
    for item in "$DST/$d"/*; do
      [ -e "$item" ] || continue
      name="$(basename "$item")"
      if [ ! -e "$SRC/$d/$name" ]; then
        OPATH+=("$item"); OLABEL+=("$d/$name")
      fi
    done
  done

  if [ "${#OPATH[@]}" -gt 0 ]; then
    echo ""
    echo "📋 项目独有项（出厂中没有）："
    local i
    for i in "${!OLABEL[@]}"; do printf "   [%d] %s\n" "$((i+1))" "${OLABEL[$i]}"; done
    echo ""
    local sel=""
    if [ -t 0 ]; then
      printf "输入要删除的编号 (空格分隔; a=全部; 回车=全部保留): "
      read -r sel || sel=""
    fi
    if [ -z "$sel" ]; then
      echo "   ✅ 全部保留。"
    elif [ "$sel" = "a" ] || [ "$sel" = "all" ]; then
      for i in "${!OPATH[@]}"; do rm -rf "${OPATH[$i]}"; echo "   🗑️  删除 ${OLABEL[$i]}"; done
    else
      local n idx
      for n in $sel; do
        case "$n" in
          ''|*[!0-9]*) echo "   ⚠ 跳过无效编号: $n" ;;
          *) idx=$((n-1))
             if [ -n "${OPATH[$idx]:-}" ]; then rm -rf "${OPATH[$idx]}"; echo "   🗑️  删除 ${OLABEL[$idx]}"
             else echo "   ⚠ 编号越界: $n"; fi ;;
        esac
      done
    fi
  fi

  # 4) 同步版本戳
  [ -f "$SRC/.factory-version" ] && cp -f "$SRC/.factory-version" "$DST/.factory-version"

  # 全程以 root 运行，挂载卷可直接读写，无需 chown。
  echo "🎉 升级完成。"
}

# ==========================================
# show_help — generate help text from providers.json
# ==========================================
show_help() {
  echo "Usage: cs PROVIDER | cs add OPTIONS | cs {upgrade|show}"
  echo ""
  # Generate provider listing from providers.json
  eval "$(_node_list_providers)"
  local i id name aliases help_desc
  for i in $(seq 0 $((_PL_COUNT - 1))); do
    eval 'id="${_PL_ID_'${i}'}"'
    eval 'help_desc="${_PL_HELPDESC_'${i}'}"'
    echo "  $(printf '%-10s' "$id") $help_desc"
  done
  echo "  upgrade   合并镜像出厂 .claude 到当前项目（保留后端配置/历史）"
  echo "  show      Show current backend & saved keys"
  echo "  add       Add a custom provider (run 'cs add --help' for options)"
  echo ""
  echo "Keys are stored in .aisc/secrets/api-keys and never committed to git."
}

# ==========================================
# _match_provider — find the canonical provider id for a given input
#   Echoes the id or exits 1 if not found.
# ==========================================
_match_provider() {
  local input="$1"
  node -e '
    var fs = require("fs");
    var pj=process.env.PROVIDERS_JSON;if(!pj)throw Error("PROVIDERS_JSON env var not set");var cfg=JSON.parse(fs.readFileSync(pj,"utf8"));
    var input = process.argv[1] || "";
    var providers = cfg.providers || {};
    for (var k in providers) {
      if (k === input) { console.log(k); process.exit(0); }
      var aliases = providers[k].aliases || [];
      if (aliases.indexOf(input) !== -1) { console.log(k); process.exit(0); }
    }
    process.exit(1);
  ' "$input"
}

# ==========================================
# _list_all_provider_names — space-separated list of all ids + aliases
# ==========================================
_list_all_provider_names() {
  node -e '
    var fs = require("fs");
    var pj=process.env.PROVIDERS_JSON;if(!pj)throw Error("PROVIDERS_JSON env var not set");var cfg=JSON.parse(fs.readFileSync(pj,"utf8"));
    var providers = cfg.providers || {};
    var names = [];
    for (var k in providers) {
      names.push(k);
      var aliases = providers[k].aliases || [];
      for (var a = 0; a < aliases.length; a++) names.push(aliases[a]);
    }
    console.log(names.join(" "));
  '
}

# ==========================================
# CLI dispatch — match against providers.json dynamically
# ==========================================
case "${1:-}" in
  show|current|"")  show_current ;;
  -h|--help)        show_help ;;
  upgrade|up)       do_upgrade ;;
  *)
    if [ -z "${1:-}" ]; then
      show_current
    else
      # Try to resolve as a provider id or alias
      resolved=$(_match_provider "$1") || die "unknown provider or command: $1 — run 'cs --help'"
      switch "$resolved"
    fi
    ;;
esac
