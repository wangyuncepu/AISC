#!/bin/bash
# cc-switch 用 HOME 推导 skills 目标。项目态使用挂载后的 /root；
# 临时态改用 /tmp/aisc-home，避免写入宿主工作区。
set -e

if [ "${CLAUDE_CONFIG_DIR:-}" = "/tmp/aisc-home/.claude" ] || \
   [ "${CODEX_HOME:-}" = "/tmp/aisc-home/.codex" ]; then
    export HOME="/tmp/aisc-home"
else
    export HOME="/root"
fi

exec cc-switch-real "$@"
