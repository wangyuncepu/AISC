#!/bin/bash
# Codex 包装器：每次启动 Codex 前从配置注入环境变量
# 类似 claude-wrapper，但适配 Codex 的配置结构
set -e

source /usr/local/bin/lib/env-inject.sh

# Codex 配置目录（类似 Claude 的 CLAUDE_CONFIG_DIR）
CODEX_CONFIG_DIR="${CODEX_CONFIG_DIR:-/root/app/.codex}"
CODEX_SETTINGS="${CODEX_CONFIG_DIR}/settings.json"

# 如果存在 Codex 专用配置，从中注入环境变量
# Codex 使用 OPENAI_API_KEY 等环境变量
if [ -f "$CODEX_SETTINGS" ]; then
    env_inject "$CODEX_SETTINGS"
fi

# 2.1.9 O9-反馈 #5a (2026-09-02): 清屏（含回滚缓冲）——bash/zsh 手动唤起
# 清屏；Workbench codex 页签直启（AISC_AGENT=codex）不受影响（详见
# claude-wrapper 同段注释）。
if [ -t 1 ] && [ "${AISC_AGENT:-manual}" != "codex" ]; then
    clear 2>/dev/null || printf '\033[H\033[2J\033[3J'
fi

# 容器本身是外部沙箱（IS_SANDBOX=1），默认给 Codex 完全执行权限，
# 与 Claude 的 --dangerously-skip-permissions 模式保持一致。
# 若用户显式指定权限/沙箱参数，则尊重用户选择，不再追加默认值。
#
# codex-adapt (2026-08-20): --dangerously-bypass-hook-trust REMOVED — the
# container image ships no codex hooks (probed live), so the flag changed
# nothing except a startup warning every session ("Enabled hooks may run
# without review"). Approval bypass alone keeps the headless behavior.
full_access_flags=(
    "--dangerously-bypass-approvals-and-sandbox"
)
has_permission_flag=0
for a in "$@"; do
    case "$a" in
        --dangerously-bypass-approvals-and-sandbox|\
        --sandbox|--sandbox=*|-s|\
        --ask-for-approval|--ask-for-approval=*|-a)
            has_permission_flag=1
            break
            ;;
    esac
done

if [ "$has_permission_flag" = "0" ]; then
    exec codex-real "${full_access_flags[@]}" "$@"
else
    exec codex-real "$@"
fi
