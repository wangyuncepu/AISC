# /usr/local/share/aisc/bashrc — AISC-managed bash initialization
# v2.1.8 T2: HISTFILE persistence + SQLite history append (via Python
# helper, parameterized — no shell SQL). ble.sh ghost text available behind
# AISC_BLE_EXPERIMENT=1 (see section 3 — Workbench PTY chain incompatibility).
# Ctrl+R history search: native bash incremental search (fzf fuzzy search
# cut per D-3, 2026-08-30).
#
# Loaded by:
#   - wrapper: bash --rcfile /usr/local/share/aisc/bashrc
#   - /root/.bashrc shim: source /usr/local/share/aisc/bashrc (tmux sub-shells)

# 0. RECURSION GUARD: wrapper --rcfile and the /root/.bashrc shim
#    cross-reference (rcfile sources ~/.bashrc → shim sources rcfile).
#    NOT exported — tmux child shells must re-initialize fully.
if [ "${AISC_BASHRC_LOADED:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi
AISC_BASHRC_LOADED=1   # shell-local; tmux panes get a fresh full init

# 1. Source user/system rc if present (non-blocking)
[ -f /etc/bash.bashrc ] && source /etc/bash.bashrc
[ -f ~/.bashrc ] && source ~/.bashrc

# 2. HISTFILE persistence (workspace-scoped via mounted runtime dir)
if [ -n "$AISC_BASH_HISTORY_FILE" ]; then
    export HISTFILE="$AISC_BASH_HISTORY_FILE"
    export HISTSIZE=10000
    export HISTCONTROL=ignoredups:erasedups
    shopt -s histappend
    # Append each command immediately: closing a tab kills bash with
    # SIGTERM/SIGKILL, which skips the exit-time history write entirely —
    # the file then stays frozen at stale content (observed 2026-08-30).
    case ";${PROMPT_COMMAND};" in
        *";history -a;"*) ;;
        *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;${PROMPT_COMMAND}}" ;;
    esac
fi

# 3. ble.sh (fish-style ghost text) — ⚠️ DEFAULT OFF (2026-08-30 手测).
#    Attaching through the Workbench terminal chain (xterm.js ↔ conPTY ↔
#    docker exec pty) freezes the shell: init prints "bash: 2: Bad file
#    descriptor" twice and keystrokes/paste are never processed. Fail-open
#    must degrade to "no completion", never "no terminal". Per-shell
#    experiment opt-in:
#      AISC_BLE_EXPERIMENT=1 bash --rcfile /usr/local/share/aisc/bashrc
#    Follow-up (挂账): try inside tmux — tmux answers the ESC[6n queries
#    ble.sh issues at attach, which isolates whether the raw PTY chain is
#    the incompatibility.
if [ "${AISC_BLE_EXPERIMENT:-0}" = "1" ] \
   && [ -f /usr/local/share/ble.sh/ble.sh ] && [[ $- == *i* ]]; then
    source /usr/local/share/ble.sh/ble.sh --noattach 2>/dev/null || \
        echo "aisc: ble.sh 加载失败（幽灵文本/高亮不可用，bash 不受影响）" >&2
fi

# 5. SQLite append via Python helper (参数化 API——shell 不拼 SQL,
#    免疫引号/换行/Unicode; fail-open)
if [ -n "$AISC_BASH_HISTORY_DB" ] && [ -n "$AISC_WORKSPACE_HASH" ]; then
    _aisc_prev_cmd=""
    _aisc_log_history() {
        local _aisc_exit=$?   # FIRST line: capture BEFORE anything
        local cmd
        cmd="$(history 1 | sed 's/^ *[0-9]* *//')"
        if [ -z "$cmd" ] || [ "$cmd" = "$_aisc_prev_cmd" ]; then
            return "$_aisc_exit"     # dedupe/empty still preserves code
        fi
        _aisc_prev_cmd="$cmd"
        AISC_HIST_DB="$AISC_BASH_HISTORY_DB" \
        AISC_HIST_WS_HASH="$AISC_WORKSPACE_HASH" \
        AISC_HIST_SESSION_ID="$AISC_TERMINAL_SESSION_ID" \
        AISC_HIST_CMD="$cmd" AISC_HIST_CWD="$PWD" \
        AISC_HIST_EXIT="$_aisc_exit" \
        python3 /usr/local/bin/lib/aisc_bash_history.py append 2>/dev/null
        return "$_aisc_exit"         # LAST: restore original code
    }
    # Idempotent append: only add if not already present.
    # (case-in patterns treat ';' as separator — use string match instead.)
    # Note: string-form PROMPT_COMMAND only. Bash array form degrades gracefully.
    if [[ ";${PROMPT_COMMAND};" != *"_aisc_log_history"* ]]; then
        PROMPT_COMMAND="_aisc_log_history;${PROMPT_COMMAND}"
    fi
fi

# 6. Attach ble.sh LAST — connects the engine to the terminal after all
#    other hooks (PROMPT_COMMAND, HISTFILE) are installed.
#    Same experiment gate as section 3: attach freezes the Workbench PTY
#    chain (see note above) — opt-in only.
[ "${AISC_BLE_EXPERIMENT:-0}" = "1" ] && [[ ${BLE_VERSION-} ]] && ble-attach
