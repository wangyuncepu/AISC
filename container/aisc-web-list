#!/usr/bin/env python3
"""aisc-web-list [--json] — list registered container web services.

Default prints one human-readable line per service
(``<port>  <protocol>  <state>  <name>``); ``--json`` prints the raw
manifest records as a JSON array for the host CLI (`aisc runtime services`).

Contract: docs/plans/container-service-access/decisions.md §5.
"""

from __future__ import annotations

import os
import sys

_lib_dir = os.environ.get("AISC_WEB_LIB_DIR") or "/usr/local/bin/lib"
if _lib_dir not in sys.path:
    sys.path.insert(0, _lib_dir)

from aisc_web_registry import main_list  # noqa: E402

if __name__ == "__main__":
    sys.exit(main_list(sys.argv[1:]))
