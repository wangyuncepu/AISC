# Operations
# ---------------------------------------------------------------------------

def op_list(agent: str) -> list[dict[str, Any]]:
    return [provider_view(agent, row) for row in read_snapshot(agent)]


def op_add(agent: str, request: dict[str, Any]) -> list[dict[str, Any]]:
    provider_id = str(request.get("id") or "").strip()
    if not provider_id or not re.match(r"^[a-z0-9][a-z0-9\-_]{0,63}$", provider_id):
        raise AdapterError(ERR_BAD_REQUEST, "request.id must be a slug-style provider id")
    existing = {row["id"] for row in read_snapshot(agent)}
    if provider_id in existing:
        raise AdapterError(
            ERR_BAD_REQUEST, f"provider id already exists: {provider_id}"
        )
    name, settings = build_add_settings(agent, request)
    if not name:
        raise AdapterError(ERR_BAD_REQUEST, "request.name is required")
    secrets = _request_secrets(request)
    _cli_add(agent, provider_id, name, settings, secrets)
    if agent == "codex" and str(request.get("mode") or "simple") == "simple":
        # A preset's upstream format must reach meta.apiFormat — the local
        # router's protocol selector. Upstream add seeds openai_responses
        # and knows nothing about the preset's anthropic endpoint.
        provider = _preset_provider(str(request.get("provider") or ""))
        declared = provider.get("codex_api_format")
        if declared:
            _db_merge_meta(agent, provider_id, {"apiFormat": declared})
    return op_list(agent)


def _request_secrets(request: dict[str, Any]) -> list[str]:
    return [str(request["api_key"])] if request.get("api_key") else []


def _merge_patch(
    agent: str, current_settings: dict[str, Any], row_id: str,
    patch: dict[str, Any], api_key: str,
) -> dict[str, Any]:
    """Apply the edit patch onto a full settings_config (never masked data)."""
    if agent == "claude":
        env = current_settings.get("env")
        env = dict(env) if isinstance(env, dict) else {}
        if patch.get("base_url"):
            env["ANTHROPIC_BASE_URL"] = str(patch["base_url"])
        if patch.get("model"):
            env["ANTHROPIC_MODEL"] = str(patch["model"])
        extras = patch.get("env")
        if isinstance(extras, dict):
            for key, value in extras.items():
                if value is None:
                    env.pop(str(key), None)
                else:
                    env[str(key)] = str(value)
        if api_key:
            env["ANTHROPIC_AUTH_TOKEN"] = api_key
        return {"env": env}
    # codex: rebuild the provider TOML from the patched fields, preserving
    # the row's existing shape — preset rows carry wire_api="responses" +
    # model_context_window (the probed working shape; a blind rebuild used
    # to flatten them to the custom-add default and break the next switch).
    fields = _codex_provider_fields(current_settings, row_id)
    base_url = str(patch.get("base_url") or fields["base_url"])
    model = str(patch.get("model") or fields["model"])
    key = api_key or fields["api_key"]
    existing_toml: dict[str, Any] = {}
    config_text = current_settings.get("config")
    if isinstance(config_text, str) and config_text:
        try:
            existing_toml = tomllib.loads(config_text)
        except Exception:
            existing_toml = {}
    provider_block: dict[str, Any] = {}
    providers = existing_toml.get("model_providers")
    if isinstance(providers, dict):
        entry = providers.get(row_id) or next(iter(providers.values()), None)
        if isinstance(entry, dict):
            provider_block = entry
    wire_api = str(provider_block.get("wire_api") or "chat")
    lines = [f'model_provider = "{row_id}"']
    if model:
        lines.append(f'model = "{model}"')
    context_window = existing_toml.get("model_context_window")
    if isinstance(context_window, int):
        lines.append(f"model_context_window = {context_window}")
    lines.extend(
        [
            'model_reasoning_effort = "high"',
            "",
            f"[model_providers.{row_id}]",
            f'name = "{row_id}"',
            f'base_url = "{base_url}"',
            f'wire_api = "{wire_api}"',
            "requires_openai_auth = true",
        ]
    )
    if key:
        lines.append(f'api_key = "{key}"')
    lines.append("")
    # auth is the live key channel (see _codex_provider_fields): preserve
    # whatever the row carries (OAuth mirror) and only set/clear the key.
    auth = dict(current_settings["auth"]) \
        if isinstance(current_settings.get("auth"), dict) else {}
    if key:
        auth["OPENAI_API_KEY"] = key
    else:
        auth.pop("OPENAI_API_KEY", None)
    result: dict[str, Any] = {"auth": auth, "config": "\n".join(lines)}
    for key_name, value in current_settings.items():
        if key_name not in result:
            result[key_name] = value  # e.g. codex "modelCatalog"
    return result


def op_edit(agent: str, provider_id: str, request: dict[str, Any]) -> list[dict[str, Any]]:
    snapshot = read_snapshot(agent)
    row = next((r for r in snapshot if r["id"] == provider_id), None)
    if row is None:
        raise AdapterError(ERR_NOT_FOUND, f"provider not found: {provider_id}")

    patch = request.get("patch")
    if not isinstance(patch, dict):
        patch = {k: v for k, v in request.items() if k != "api_key"}
    api_key = str(request.get("api_key") or "")
    new_settings = _merge_patch(agent, row["settings"], provider_id, patch, api_key)
    new_name = str(patch.get("name") or row["name"])
    secrets = _request_secrets(request) + snapshot_secrets(agent, snapshot)

    was_current = row["is_current"]
    switch_back_to = ""
    if was_current:
        switch_back_to = provider_id
        _cli_switch(agent, _switch_away_target(agent, snapshot, provider_id), secrets)
    _db_delete(agent, provider_id)
    try:
        _cli_add(agent, provider_id, new_name, new_settings, secrets)
    except AdapterError:
        # The dance window: deleted but the re-add failed. Best-effort
        # restore of the exact previous state, then surface the failure.
        try:
            _cli_add(agent, provider_id, row["name"], row["settings"], secrets)
            _db_merge_meta(agent, provider_id, row.get("meta") or {})
            if was_current:
                _cli_switch(agent, provider_id, secrets)
        except AdapterError as restore_exc:
            raise AdapterError(
                ERR_RESTORE_FAILED,
                f"edit failed AND restore failed; provider {provider_id} is "
                f"deleted (restore error: {restore_exc.message})",
            ) from restore_exc
        raise
    # The re-add seeded fresh defaults — the original row's meta (e.g. the
    # router's codex apiFormat selector, user/TUI-written) must survive the
    # dance or every routed request 404s.
    _db_merge_meta(agent, provider_id, row.get("meta") or {})
    if switch_back_to:
        _cli_switch(agent, switch_back_to, secrets)
    return op_list(agent)


_PROVIDER_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9\-_]{0,63}$")

# Pseudo target meaning "stop using the proxy provider, go back to the
# direct-official row" (IDEA-4 manual round 3).
OFFICIAL_TARGET = "official"
_OFFICIAL_ROW_ID = {"claude": "claude-official", "codex": "codex-official"}


def _cli_switch_empty_config(agent: str, provider_id: str) -> None:
    """Switch to an EMPTY-config row (the official/direct placeholders).

    Upstream prompts a confirmation on these rows — a non-tty exec dies with
    "Prompt failed" (8a probe). Probed fix: run under a pty (`script -qec`,
    util-linux) and answer "y". The id is SLUG-VALIDATED before it enters
    the shell command string (injection guard).
    """
    if not _PROVIDER_ID_RE.match(provider_id):
        raise AdapterError(ERR_BAD_REQUEST, f"invalid provider id: {provider_id!r}")
    cmd = f"cc-switch -a {agent} provider switch {provider_id}"
    completed = run_raw(["script", "-qec", cmd, "/dev/null"], "y\ny\n")
    if completed.returncode != 0 or "Switched to provider" not in (completed.stdout or ""):
        detail = (completed.stdout + completed.stderr).strip()[:300]
        raise AdapterError(
            ERR_CLI,
            f"provider switch {provider_id} failed (exit {completed.returncode}): {detail}",
        )


_AUTH_PLACEHOLDER = '{"OPENAI_API_KEY":"AISC_PROXY_PLACEHOLDER"}'


def _codex_auth_path() -> Path:
    root = os.environ.get("CODEX_CONFIG_DIR") or os.environ.get("CODEX_HOME")
    if not root:
        raise AdapterError(ERR_BAD_REQUEST, "CODEX_CONFIG_DIR is not set")
    return Path(root) / "auth.json"


def _manage_codex_auth_placeholder(*, remove: bool) -> None:
    """Interactive codex refuses to start without an auth.json (its own
    onboarding wizard — IDEA-4 round 5 manual find). Only an EMPTY auth.json
    gets the marker: a row whose auth carries the real key has already been
    live-synced by the switch itself, and that is the token the proxy worker
    captures at enable (it does NOT inject one of its own — live-probed
    2026-08-21). A REAL login file is never touched, and the marker is
    removed again when switching back to official."""
    path = _codex_auth_path()
    try:
        existing = path.read_text(encoding="utf-8").strip() if path.is_file() else ""
    except OSError:
        return
    if remove:
        if existing == _AUTH_PLACEHOLDER:
            try:
                path.unlink()
            except OSError:
                pass
        return
    if not existing:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(_AUTH_PLACEHOLDER, encoding="utf-8")
            os.chmod(path, 0o600)
        except OSError:
            pass  # best-effort: the wizard stays, but the switch itself holds


# ---------------------------------------------------------------------------
# codex model catalog (codex-adapt 修复轮 2026-08-20)
#
# Zero-step goal (user decision): key in + switch = codex fully usable, /model
# lists the provider's models, no metadata degradation. Upstream cc-switch
# generates the catalog ONLY inside its TUI model-mapping workflow — the
# headless CLI switch our adapter drives never does (binary-string + live
# evidence). So the adapter generates it itself, anchored on CODEX's own
# contract (models-manager's `model_catalog_json` config key + the ModelInfo
# schema), NOT on cc-switch's template: a neutral entry carries exactly
# codex's serde-required fields with identity/window overrides.
# ---------------------------------------------------------------------------

_CODEX_CATALOG_FILENAME = "aisc-model-catalog.json"


def _codex_config_dir() -> Path:
    root = os.environ.get("CODEX_CONFIG_DIR") or os.environ.get("CODEX_HOME")
    if not root:
        raise AdapterError(ERR_BAD_REQUEST, "CODEX_CONFIG_DIR is not set")
    return Path(root)


def _codex_neutral_catalog_entry(model: str, context_window: int, priority: int) -> dict[str, Any]:
    """codex-rs protocol `ModelInfo` — serde-required fields only (probed
    from codex 0.148's bundled gpt-5.5 entry; the heavy optional harness
    fields are serde-defaulted and intentionally omitted). Beyond serde,
    codex validates every entry carries `base_instructions` OR
    `model_messages.instructions_template` — missing both is a fatal
    startup error, so we mirror cc-switch's own catalog value."""
    return {
        "slug": model,
        "display_name": model,
        "description": None,
        "base_instructions": (
            "You are Codex, a coding agent. You and the user share the same "
            "workspace and collaborate to achieve the user's goals."
        ),
        "supported_reasoning_levels": [
            {"effort": "high", "description": "High reasoning effort"}
        ],
        "shell_type": "shell_command",
        "visibility": "list",
        "supported_in_api": True,
        "priority": priority,
        "availability_nux": None,
        "upgrade": None,
        "support_verbosity": False,
        "default_verbosity": None,
        "apply_patch_tool_type": None,
        "truncation_policy": {"mode": "tokens", "limit": 10000},
        "experimental_supported_tools": [],
        "context_window": context_window,
        "max_context_window": context_window,
    }


def _codex_catalog_key_value(config_text: str) -> Optional[str]:
    for line in config_text.splitlines():
        m = re.match(r'^\s*model_catalog_json\s*=\s*"([^"]+)"', line)
        if m:
            return m.group(1)
    return None


def _set_codex_catalog_key(config_text: str, new_value: Optional[str]) -> str:
    """Set/remove OUR catalog key (top-level). Ownership rule (mirrors
    cc-switch's): a foreign value (cc-switch's managed file or a user path)
    is never touched; removal only ever drops our own filename."""
    current = _codex_catalog_key_value(config_text)
    if current is not None and Path(current).name != _CODEX_CATALOG_FILENAME:
        return config_text
    key_line_re = re.compile(r"^\s*model_catalog_json\s*=")
    out: list[str] = []
    inserted = False
    for line in config_text.splitlines():
        if key_line_re.match(line):
            if new_value is not None and not inserted:
                out.append(f'model_catalog_json = "{new_value}"')
                inserted = True
            continue
        out.append(line)
        # top-level only: insert right before the first table header
        if new_value is not None and not inserted and line.strip().startswith("["):
            out.insert(len(out) - 1, f'model_catalog_json = "{new_value}"')
            inserted = True
    if new_value is not None and not inserted:
        out.append(f'model_catalog_json = "{new_value}"')
    result = "\n".join(out)
    if config_text.endswith("\n") and new_value is not None:
        result += "\n"
    return result


def _apply_codex_model_catalog(row: Optional[dict[str, Any]]) -> None:
    """Post-switch hook: write the catalog file + point config.toml at it.

    Catalog source = the PRESET module by provider id, NOT the db row's
    settings_config — upstream's codex switch round-trips the LIVE config
    back into the stored settings (live-setting import), stripping unknown
    keys like modelCatalog on every switch (live-verified 2026-08-20).

    Custom providers (no preset entry): single-row catalog from the live
    `model` line (default window) so /model at least lists the active model.
    The live `model` value also gets its Claude-side ``[1m]`` suffix
    stripped when the clean id matches a catalog slug — that suffix is a
    Claude Code convention and not a valid wire id.

    ``row`` None (official switch) or a provider without any model info →
    remove OUR key/file so codex falls back to its bundled list. Best-effort:
    a failure never fails the switch itself.
    """
    try:
        config_path = _codex_config_dir() / "config.toml"
        catalog_path = _codex_config_dir() / _CODEX_CATALOG_FILENAME
        text = config_path.read_text(encoding="utf-8") if config_path.is_file() else ""

        # FULL DEFERENCE: when cc-switch's own catalog is active (user mapped
        # models via the TUI), it owns the whole codex tail state — our window
        # key would OVERRIDE its catalog rows (codex's with_config_overrides
        # takes the config key over entry windows). Touch nothing.
        current_key = _codex_catalog_key_value(text)
        if current_key is not None and Path(current_key).name != _CODEX_CATALOG_FILENAME:
            return

        models: list[dict[str, Any]] = []
        api_format = None
        live_model = _codex_live_model(text)
        if row is not None:
            try:
                preset = _preset_provider(str(row.get("id") or ""))
            except AdapterError:
                preset = {}
            raw = preset.get("model_catalog")
            if isinstance(raw, list) and raw:
                models = [m for m in raw if isinstance(m, dict) and m.get("model")]
            api_format = preset.get("codex_api_format")
        if not models and live_model:
            models = [{"model": live_model, "contextWindow": 128_000}]

        if models:
            slugs = {str(m["model"]) for m in models}
            entries = [
                _codex_neutral_catalog_entry(
                    str(m["model"]),
                    int(m.get("contextWindow") or 128_000),
                    1000 + i,
                )
                for i, m in enumerate(models)
            ]
            catalog_path.write_text(
                json.dumps({"models": entries}, ensure_ascii=True, indent=2) + "\n",
                encoding="utf-8",
            )
            new_text = _set_codex_catalog_key(text, str(catalog_path))
            # window fallback for the no-catalog path + [1m] cleanup
            window = int(models[0].get("contextWindow") or 128_000)
            new_text = _set_codex_top_level_int(new_text, "model_context_window", window)
            if live_model and live_model not in slugs:
                clean = live_model.replace("[1m]", "")
                if clean in slugs:
                    new_text = _set_codex_model_line(new_text, clean)
            # cc-switch's Anthropic transform drops the web_search hosted
            # tool — never present it as a dead tool (upstream does the same
            # for its anthropic-profile switches).
            if api_format == "anthropic":
                new_text = _set_codex_top_level_str(new_text, "web_search", "disabled")
            else:
                new_text = _set_codex_top_level_str(new_text, "web_search", None)
        else:
            new_text = _set_codex_catalog_key(text, None)
            new_text = _set_codex_top_level_int(new_text, "model_context_window", None)
            new_text = _set_codex_top_level_str(new_text, "web_search", None)
            try:
                catalog_path.unlink()
            except OSError:
                pass

        if new_text != text:
            config_path.write_text(new_text, encoding="utf-8")
    except (OSError, ValueError, TypeError):
        return  # best-effort by contract


def _codex_live_model(config_text: str) -> Optional[str]:
    for line in config_text.splitlines():
        m = re.match(r'^\s*model\s*=\s*"([^"]+)"', line)
        if m:
            return m.group(1)
    return None


def _set_codex_model_line(config_text: str, value: str) -> str:
    out = []
    replaced = False
    for line in config_text.splitlines():
        if not replaced and re.match(r'^\s*model\s*=', line):
            out.append(f'model = "{value}"')
            replaced = True
        else:
            out.append(line)
    return "\n".join(out)


def _set_codex_top_level_str(config_text: str, key: str, value: Optional[str]) -> str:
    """Set/remove a top-level string key. Only manages the sentinel values we
    wrote ("disabled" for web_search) — anything else (a user's own setting)
    survives untouched, mirroring cc-switch's ownership rule."""
    key_re = re.compile(rf'^\s*{re.escape(key)}\s*=')
    sentinel = "disabled"
    lines = config_text.splitlines()
    current = None
    for line in lines:
        m = key_re.match(line)
        if m:
            current = line.split("=", 1)[1].strip()
            break
    if current is not None and current != f'"{sentinel}"' and current != sentinel:
        return config_text  # foreign value: not ours to touch
    out: list[str] = []
    inserted = False
    for line in lines:
        if key_re.match(line):
            if value is not None and not inserted:
                out.append(f'{key} = "{value}"')
                inserted = True
            continue
        out.append(line)
        if value is not None and not inserted and line.strip().startswith("["):
            out.insert(len(out) - 1, f'{key} = "{value}"')
            inserted = True
    if value is not None and not inserted:
        out.append(f'{key} = "{value}"')
    return "\n".join(out)


def _set_codex_top_level_int(config_text: str, key: str, value: Optional[int]) -> str:
    """Set/remove a top-level integer key (before the first table header).
    Unlike the catalog key this is plain config, ours to manage."""
    key_re = re.compile(rf"^\s*{re.escape(key)}\s*=")
    out: list[str] = []
    inserted = False
    for line in config_text.splitlines():
        if key_re.match(line):
            if value is not None and not inserted:
                out.append(f"{key} = {value}")
                inserted = True
            continue
        out.append(line)
        if value is not None and not inserted and line.strip().startswith("["):
            out.insert(len(out) - 1, f"{key} = {value}")
            inserted = True
    if value is not None and not inserted:
        out.append(f"{key} = {value}")
    return "\n".join(out)


def op_switch(agent: str, provider_id: str) -> list[dict[str, Any]]:
    """Activate a provider (IDEA-4): official non-interactive `provider switch`.

    ``official`` (pseudo target) = switch back to the agent's direct-official
    row — the "cancel proxy" affordance. Real-config targets use the plain
    CLI path; empty-config targets (official placeholders) go through the
    pty path. Switching to the already-current provider is idempotent.
    """
    if provider_id == OFFICIAL_TARGET:
        provider_id = _OFFICIAL_ROW_ID[agent]
    snapshot = read_snapshot(agent)
    row = next((r for r in snapshot if r["id"] == provider_id), None)
    if row is None:
        raise AdapterError(ERR_NOT_FOUND, f"provider not found: {provider_id}")
    if row["is_current"]:
        return op_list(agent)  # already active — idempotent success
    secrets = snapshot_secrets(agent, snapshot)
    to_official = provider_id.endswith("-official")
    if agent == "codex":
        # Codex only reaches third-party providers through cc-switch's LOCAL
        # proxy route (default OFF — without it codex talks to api.openai.com
        # regardless of model_provider; probed on the real container). The
        # worker serves the upstream token it CAPTURES from live auth.json at
        # enable time — it neither passes the client bearer through nor reads
        # the DB per request (live-probed 2026-08-21) — so the route must be
        # torn down BEFORE the switch rewrites live files and re-enabled
        # AFTER, mirroring the manual disable→(fix)→enable sequence verified
        # on the real container. Interactive codex ALSO demands an auth.json
        # before it starts — a marker placeholder that never carries a secret
        # and never touches a real ChatGPT login is managed post-switch.
        _cli(["proxy", "-a", "codex", "disable"], secrets=secrets,
             what="codex proxy route disable")
    if _settings_are_real(agent, row):
        _cli_switch(agent, provider_id, secrets)
    else:
        _cli_switch_empty_config(agent, provider_id)
    if agent == "codex":
        if not to_official:
            _cli(["proxy", "-a", "codex", "enable"], secrets=secrets,
                 what="codex proxy route enable")
        _manage_codex_auth_placeholder(remove=to_official)
        # Zero-step goal: /model lists the provider's models right after the
        # switch (no TUI visit, no manual model entry).
        _apply_codex_model_catalog(None if to_official else row)
    return op_list(agent)


def op_delete(agent: str, provider_id: str) -> list[dict[str, Any]]:
    snapshot = read_snapshot(agent)
    row = next((r for r in snapshot if r["id"] == provider_id), None)
    if row is None:
        raise AdapterError(ERR_NOT_FOUND, f"provider not found: {provider_id}")
    secrets = snapshot_secrets(agent, snapshot)
    if row["is_current"]:
        _cli_switch(agent, _switch_away_target(agent, snapshot, provider_id), secrets)
    _db_delete(agent, provider_id)
    return op_list(agent)


# ---------------------------------------------------------------------------
# fetch-models (IDEA-5 5c): the remote model list for the mapping dropdown.
# Upstream has no --json — stdout is human text and UNTRUSTED; parsing is
# defensive and any failure degrades to available=false (the UI falls back
# to known_models + manual input) instead of an error envelope.
# ---------------------------------------------------------------------------

# Bracket chars are model-id-legal (DeepSeek's `[1m]` context suffix).
_MODEL_LINE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/@+\-\[\]]*$")
_MODEL_TOKEN_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._\-\[\]]{3,}")
_LINE_NOISE_PREFIXES = (
    "fetching", "fetched", "endpoint", "error", "http", "provider", "models",
    "total", "found", "retrieved", "using", "model", "id", "name", "owned",
    "object", "created",
)


def _looks_like_model_id(token: str) -> bool:
    """Residual-CLI-text filter: real model ids are namespaced (contain a
    digit, '-', '.' or '_') or long; table-header words like Model/Fetched/
    model fail it. Bracket chars keep DeepSeek's `[1m]` suffix legal."""
    if len(token) >= 10:
        return True
    return any(c in token for c in "0123456789-._")


def _parse_model_lines(text: str) -> list[str]:
    """LAST-RESORT extraction from upstream's human output (the JSON chain
    is the primary path). Accepts one-id-per-line (with bullet/decoration)
    and `label: id` pairs; skips noise lines and header words. Deduped,
    order preserved, capped."""
    out: list[str] = []
    for raw in text.splitlines():
        line = raw.strip().lstrip("-*•·—> ").strip()
        if not line or len(line) > 120:
            continue
        low = line.lower()
        if any(low.startswith(p) for p in _LINE_NOISE_PREFIXES):
            continue
        candidates: list[str] = []
        if _MODEL_LINE_RE.match(line) and "/" not in line:
            candidates = [line]
        else:
            # `label: value` / tab-separated — take tokens that look like ids.
            tail = line.rsplit(":", 1)[-1] if ":" in line else line
            candidates = _MODEL_TOKEN_RE.findall(tail)
        for c in candidates:
            if c.lower() in ("true", "false", "null", "none"):
                continue
            if not _looks_like_model_id(c):
                continue
            out.append(c)
    return list(dict.fromkeys(out))[:200]


def _http_get_json(url: str, headers: dict[str, str], timeout: float) -> tuple[int, Any]:
    """Injectable HTTP GET returning (status, parsed-json-or-None). The
    default uses stdlib urllib; tests stub this seam."""
    import urllib.request
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            import json as _json
            return int(resp.status), _json.loads(resp.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        return int(exc.code), None
    except (urllib.error.URLError, OSError, ValueError):
        return 0, None


# Mirrors upstream cc-switch services/model_fetch.rs: anthropic-compat base
# suffixes whose stripped root also serves OpenAI-style model lists.
_KNOWN_COMPAT_SUFFIXES = ("/api/anthropic", "/apps/anthropic", "/anthropic")


def _models_url_candidates(base_url: str) -> list[str]:
    """Port of upstream build_models_url_candidates (dedup, order kept):

    1. base ends with a version segment `/v{N}` (e.g. `/api/coding/paas/v4`)
       → `{base}/models` first (and `{base}/v1/models` unless it IS `/v1`)
    2. else `{base}/v1/models`
    3. base ends with a KNOWN_COMPAT_SUFFIX → stripped root gains BOTH
       `/v1/models` and bare `/models` (e.g. DeepSeek documents
       `https://api.deepseek.com/models` WITHOUT /v1)."""
    trimmed = base_url.strip().rstrip("/")
    if not trimmed:
        return []
    candidates: list[str] = []
    last = trimmed.rsplit("/", 1)[-1]
    versioned = last.startswith("v") and last[1:].isdigit()
    if versioned:
        candidates.append(f"{trimmed}/models")
        if not trimmed.endswith("/v1"):
            candidates.append(f"{trimmed}/v1/models")
    else:
        candidates.append(f"{trimmed}/v1/models")
    for suffix in _KNOWN_COMPAT_SUFFIXES:
        if trimmed.endswith(suffix):
            root = trimmed[: -len(suffix)].rstrip("/")
            if root and "://" in root:
                candidates.append(f"{root}/v1/models")
                candidates.append(f"{root}/models")
            break
    return list(dict.fromkeys(candidates))


def _openai_compatible_models(base_url: str, api_key: str) -> list[str] | None:
    """The documented fetch path (user-manual 2.1 §自动获取模型), ported from
    upstream services/model_fetch.rs: walk the candidate model-list URLs and
    the two auth styles (Bearer default; x-api-key for anthropic-format
    providers — we don't track api_format per row, so both are tried).
    Returns None when every candidate rejects us; the caller degrades."""
    if not base_url:
        return None
    header_sets: list[dict[str, str]] = []
    if api_key:
        header_sets.append({"Authorization": f"Bearer {api_key}"})
        header_sets.append({"x-api-key": api_key, "anthropic-version": "2023-06-01"})
    else:
        header_sets.append({})
    for url in _models_url_candidates(base_url):
        for headers in header_sets:
            status, payload = _http_get_json(url, headers, 15.0)
            if status != 200 or not isinstance(payload, dict):
                continue
            data = payload.get("data")
            if not isinstance(data, list):
                continue
            ids = [str(m.get("id")) for m in data if isinstance(m, dict) and m.get("id")]
            if ids:
                return ids
    return None


def op_fetch_models(agent: str, provider_id: str) -> dict[str, Any]:
    snapshot = read_snapshot(agent)
    row = next((r for r in snapshot if r["id"] == provider_id), None)
    if row is None:
        raise AdapterError(ERR_NOT_FOUND, f"provider not found: {provider_id}")

    # PRIMARY: the JSON candidate chain (upstream services/model_fetch.rs
    # semantics) — deterministic `data[].id` parsing, no human-text noise.
    # The key is used transiently in-process and never enters the envelope.
    env = row["settings"].get("env")
    env = env if isinstance(env, dict) else {}
    base_url = str(env.get("ANTHROPIC_BASE_URL") or "")
    api_key = str(env.get("ANTHROPIC_AUTH_TOKEN") or env.get("ANTHROPIC_API_KEY") or "")
    models = _openai_compatible_models(base_url, api_key) if base_url else None
    if models:
        return {"available": True, "models": models, "message": ""}

    # FALLBACK: the upstream CLI subcommand (its own candidate chain), with
    # the tightened last-resort text parse.
    secrets = snapshot_secrets(agent, snapshot)
    completed = run_cli(
        ["-a", agent, "provider", "fetch-models", provider_id], "", secrets
    )
    combined = f"{completed.stdout or ''}\n{completed.stderr or ''}"
    cli_failed = completed.returncode != 0 or "error" in combined.lower()
    if not cli_failed:
        parsed = _parse_model_lines(completed.stdout or "")
        if parsed:
            return {"available": True, "models": parsed, "message": ""}

    lines = [l.strip() for l in combined.splitlines() if l.strip()]
    detail = next((l for l in reversed(lines)), "") or f"exit {completed.returncode}"
    return {"available": False, "models": [], "message": redact(detail, secrets)[:200]}


# ---------------------------------------------------------------------------
# Envelope + entry point
# ---------------------------------------------------------------------------

def _envelope(op: str, ok: bool, *, providers: Optional[list] = None,
              usage: Optional[dict] = None,
              fetch_models: Optional[dict] = None,
              error: Optional[dict] = None) -> dict[str, Any]:
    out: dict[str, Any] = {
        "schema": PROTOCOL,
        "operation_id": str(uuid.uuid4()),
        "op": op,
        "ok": ok,
    }
    if providers is not None:
        out["providers"] = providers
    if usage is not None:
        out["usage"] = usage
    if fetch_models is not None:
        out["fetch_models"] = fetch_models
    if error is not None:
        out["error"] = error
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="aisc-cc-provider")
    parser.add_argument("op", choices=["list", "add", "edit", "switch", "delete",
                                       "usage", "fetch-models"])
    parser.add_argument("--agent", default=None, choices=list(AGENTS),
                        help="agent (required for every op except usage)")
    parser.add_argument("--id", default=None, help="provider id (add/edit/delete)")
    parser.add_argument("--since", type=float, default=0.0,
                        help="usage: epoch-seconds cutoff computed host-side "
                             "(local timezone semantics)")
    args = parser.parse_args(argv)

    if args.op == "usage":
        try:
            print(json.dumps(_envelope(
                args.op, True, usage=op_usage(args.since),
            )))
            return 0
        except AdapterError as exc:
            print(json.dumps(_envelope(
                args.op, False, error={"code": exc.code, "message": exc.message},
            )))
            return 1

    if args.op == "fetch-models":
        if not args.agent:
            print(json.dumps(_envelope(
                args.op, False,
                error={"code": ERR_BAD_REQUEST, "message": "fetch-models requires --agent"},
            )))
            return 2
        if not args.id:
            print(json.dumps(_envelope(
                args.op, False,
                error={"code": ERR_BAD_REQUEST, "message": "fetch-models requires --id"},
            )))
            return 2
        try:
            print(json.dumps(_envelope(
                args.op, True, fetch_models=op_fetch_models(args.agent, args.id),
            )))
            return 0
        except AdapterError as exc:
            print(json.dumps(_envelope(
                args.op, False, error={"code": exc.code, "message": exc.message},
            )))
            return 1

    if not args.agent:
        print(json.dumps(_envelope(
            args.op, False,
            error={"code": ERR_BAD_REQUEST, "message": f"{args.op} requires --agent"},
        )))
        return 2

    request: dict[str, Any] = {}
    if args.op in ("add", "edit"):
        raw = sys.stdin.read()
        if raw.strip():
            try:
                request = json.loads(raw)
            except json.JSONDecodeError as exc:
                print(json.dumps(_envelope(
                    args.op, False,
                    error={"code": ERR_BAD_REQUEST, "message": f"bad request JSON: {exc}"},
                )))
                return 2
            if not isinstance(request, dict):
                print(json.dumps(_envelope(
                    args.op, False,
                    error={"code": ERR_BAD_REQUEST, "message": "request must be a JSON object"},
                )))
                return 2

    try:
        if args.op == "list":
            providers = op_list(args.agent)
        elif args.op == "add":
            request.setdefault("id", args.id)
            providers = op_add(args.agent, request)
        elif args.op == "edit":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "edit requires --id")
            providers = op_edit(args.agent, args.id, request)
        elif args.op == "switch":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "switch requires --id")
            providers = op_switch(args.agent, args.id)
        else:
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "delete requires --id")
            providers = op_delete(args.agent, args.id)
        print(json.dumps(_envelope(args.op, True, providers=providers)))
        return 0
    except AdapterError as exc:
        print(json.dumps(_envelope(
            args.op, False, error={"code": exc.code, "message": exc.message},
        )))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
